# Django
DJANGO_SECRET_KEY=change-me-in-production-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
POSTGRES_DB=payledger
POSTGRES_USER=payledger
POSTGRES_PASSWORD=payledger_secret
DATABASE_URL=postgres://payledger:payledger_secret@db:5432/payledger

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Idempotency key TTL in seconds (24 hours)
IDEMPOTENCY_KEY_TTL=86400

# Webhook signing secret (HMAC-SHA256)
WEBHOOK_SIGNING_SECRET=change-me-webhook-secret
